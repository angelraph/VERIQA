# Deployer wallet private key (never commit the real .env)
DEPLOYER_PRIVATE_KEY=

# RPC overrides
QIE_MAINNET_RPC=https://rpc1mainnet.qie.digital/
QIE_TESTNET_RPC=https://rpc1testnet.qie.digital/

# Explorer verification (confirm actual endpoint before first deploy)
QIE_EXPLORER_API_KEY=
QIE_MAINNET_EXPLORER_API=https://mainnet.qie.digital/api
QIE_TESTNET_EXPLORER_API=https://testnet.qie.digital/api

# QUSDC token address — confirmed via mainnet.qie.digital token explorer
# (verified contract, name "QUSDC", 6 decimals, no permit() — standard approve/transferFrom only)
QUSDC_MAINNET_ADDRESS=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5
# Testnet QUSDC address not yet confirmed (mainnet is the deploy target regardless)
QUSDC_TESTNET_ADDRESS=
