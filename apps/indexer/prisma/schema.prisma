// Local dev/test uses SQLite (DATABASE_URL="file:./dev.db"). Every field type is
// Prisma-portable, so production switches `provider` to "postgresql" via
// prisma/schema.postgres.prisma (generated by scripts/use-postgres.mjs).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  wallet            String         @id
  profileURI        String
  qieName           String?
  passVerified      Boolean        @default(false)
  active            Boolean        @default(true)
  createdAt         DateTime
  registeredAtBlock String
  payments          Payment[]
  scoreHistory      ScoreHistory[]
  insights          Insight[]
  advances          Advance[]
}

model Payment {
  receiptId      String   @id
  merchant       Merchant @relation(fields: [merchantWallet], references: [wallet])
  merchantWallet String
  payer          String
  amount         String // base units, string to avoid float precision loss
  invoiceRef     String
  timestamp      DateTime
  txHash         String
  blockNumber    String
  /// 0 = Settled (money moved on-chain), 1 = Attested (cash sale co-signed by customer)
  tier           Int      @default(0)
  /// 0 = QUSDC, 1 = QIE (swapped via QIEDEX), 2 = Cash / bank transfer
  method         Int      @default(0)
  repaidToPool   String   @default("0")

  @@index([merchantWallet, timestamp])
  @@index([payer])
}

model ScoreHistory {
  id               Int      @id @default(autoincrement())
  merchant         Merchant @relation(fields: [merchantWallet], references: [wallet])
  merchantWallet   String
  score            Int
  periodId         Int
  inputsHash       String   @default("")
  computedAt       DateTime @default(now())
  publishedOnChain Boolean  @default(false)
  publishTxHash    String?

  @@index([merchantWallet, periodId])
}

model Advance {
  id             Int       @id @default(autoincrement())
  merchant       Merchant  @relation(fields: [merchantWallet], references: [wallet])
  merchantWallet String
  principal      String
  fee            String
  repayBps       Int
  outstanding    String
  startedAt      DateTime
  dueAt          DateTime
  /// "open" | "closed" | "defaulted" | "closed_after_default"
  status         String    @default("open")
  closedAt       DateTime?
  txHash         String
  repayments     AdvanceRepayment[]

  @@index([merchantWallet, status])
}

model AdvanceRepayment {
  id         Int      @id @default(autoincrement())
  advance    Advance  @relation(fields: [advanceId], references: [id])
  advanceId  Int
  amount     String
  automatic  Boolean
  from       String
  remaining  String
  txHash     String
  logIndex   Int
  timestamp  DateTime

  @@unique([txHash, logIndex])
}

model Insight {
  id                           Int      @id @default(autoincrement())
  merchant                     Merchant @relation(fields: [merchantWallet], references: [wallet])
  merchantWallet               String
  periodStart                  DateTime
  scoreDelta                   Int
  revenueChangePct             Float?
  uniqueCustomersThisWeek      Int
  uniqueCustomersTrailingAvg   Float
  daysSinceTopCustomerLastPaid Int?
  newCustomerCount             Int
  repeatCustomerRate           Float
  summarySentence              String
  createdAt                    DateTime @default(now())
}

/// Singleton-per-key table tracking poller progress across restarts.
model IndexerState {
  key       String @id
  lastBlock String
}
