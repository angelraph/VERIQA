{
  "name": "@veriga/indexer",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "poll": "tsx src/poller.ts",
    "insights": "tsx src/insights/run.ts",
    "test": "node scripts/sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "publish-scores": "tsx src/publisher.ts",
    "db:push": "prisma db push --skip-generate",
    "dev:sqlite": "node scripts/sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma && tsx watch src/server.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@veriga/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "node-cron": "^3.0.3",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "main": "src/server.ts"
}
