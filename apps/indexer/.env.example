# Local dev/test: SQLite file DB. Production: point to Postgres, e.g.
# postgresql://user:password@host:5432/veriga
DATABASE_URL="file:./dev.db"

# Chain
QIE_MAINNET_RPC=https://rpc1mainnet.qie.digital/

# Deployed contract addresses (see contracts/README.md after deploy)
MERCHANT_REGISTRY_ADDRESS=
PAYMENT_RECEIPTS_ADDRESS=
TRUST_SCORE_ORACLE_ADDRESS=
WORKING_CAPITAL_POOL_ADDRESS=

# Trusted updater key: publishes score checkpoints + trailing-volume updates on-chain.
# Never commit the real value.
UPDATER_PRIVATE_KEY=

# QIE Pass partner API (see README.md "QIE Pass" section), sign up yourself, never
# share the secret with anyone including this assistant.
QIE_PASS_API_BASE=https://did-stapi.qie.digital/api/v1
QIE_PASS_PUBLIC_KEY=
QIE_PASS_API_SECRET=

# Optional: only used to phrase already-computed weekly stats into plain English.
# The product must be fully demoable with this unset (falls back to templates).
OPENAI_API_KEY=

PORT=4000
